{
  "name": "penfii-client",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @penfii/web",
    "build": "npm run build -w @penfii/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "knip": "knip && knip --production",
    "contract:sync": "node scripts/sync-openapi.mjs",
    "contract:check": "node scripts/sync-openapi.mjs --check"
  },
  "overrides": {
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^28.0.0",
    "knip": "6.44.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
