# Settings for the official Docker Compose install (docker/compose.yaml).
# Copy this file to `.env` in the same directory and replace every CHANGE_ME.
# Never commit `.env`.

# --- Where people open Penfii ---------------------------------------------------------------
# The origin people type in the browser, with no path and no trailing slash. Sign-in redirects,
# the co-editing socket and the MCP gateway use it. A value starting with https:// also turns on
# the Secure flag of the session cookie, so only use https:// when a TLS proxy really sits in front.
PENFII_PUBLIC_URL=http://localhost:8080
# Host address and port the web container is published on. By default it is reachable from this
# machine only; put a TLS reverse proxy in front of it, or set the address to 0.0.0.0 for a trusted LAN.
PENFII_HTTP_BIND=127.0.0.1
PENFII_HTTP_PORT=8080

# --- Secrets (no defaults) ------------------------------------------------------------------
# Use letters and digits only for POSTGRES_PASSWORD: it is placed inside DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
# Two more database roles, made by the `db-setup` service on the first start: the schema owner (runs the
# migrations) and the runtime role (what core-api and admin-cli connect as: row access only, no schema
# changes). POSTGRES_PASSWORD above is the PostgreSQL superuser, used only by `db-setup` to make them.
# Letters and digits only, for the same reason. Upgrading an installation made before these roles
# existed: also set PENFII_DB_OWNER_USER=penfii and PENFII_DB_OWNER_PASSWORD to the value of
# POSTGRES_PASSWORD (its objects stay owned by `penfii`); see docs/self-hosting.md.
PENFII_DB_OWNER_PASSWORD=CHANGE_ME
PENFII_DB_RUNTIME_PASSWORD=CHANGE_ME
#PENFII_DB_OWNER_USER=penfii_owner
#PENFII_DB_RUNTIME_USER=penfii_app
# The object storage (MinIO) root key pair (8+ characters). Used by MinIO itself and by the one-shot
# `minio-setup` service; core-api uses the app key pair below instead.
PENFII_S3_ACCESS_KEY=CHANGE_ME
PENFII_S3_SECRET_KEY=CHANGE_ME
# The app key pair: `minio-setup` makes this account, limited to reading, writing and deleting objects in
# the bucket, and core-api connects as it (8+ characters, different from the root pair, letters and digits).
# New installation: set both. An installation from before this existed has neither and keeps working with
# core-api on the root key pair (minio-setup warns on every start); to move it over, see docs/self-hosting.md,
# "Object storage access key". Set both or neither.
PENFII_S3_APP_ACCESS_KEY=CHANGE_ME
PENFII_S3_APP_SECRET_KEY=CHANGE_ME

# --- Limits core-api requires ---------------------------------------------------------------
# Each of these has no built-in default on purpose; a missing one disables the feature it guards
# (sign-in, messages, invitations, file upload). Change them if you want other limits.
PENFII_SESSION_TTL_SECONDS=43200
# Optional: the "Keep me signed in" choice on the sign-in page. A person who ticks it gets a session that
# ends 30 days after sign-in at the latest and after 7 days without activity. Uncomment to change.
# PENFII_LONG_SESSION_ENABLED=1
# PENFII_LONG_SESSION_MAX_AGE_SECONDS=2592000
# PENFII_LONG_SESSION_IDLE_SECONDS=604800
PENFII_MESSAGE_BODY_MAX_BYTES=65536
PENFII_INVITE_TTL_SECONDS=604800
PENFII_FILE_MAX_BYTES=104857600
PENFII_MESSAGE_FILE_MAX_COUNT=10
PENFII_MESSAGE_FILE_MAX_BYTES=209715200

# --- Reverse proxy in front of the web container ---------------------------------------------
# Sign-in attempts are counted per client address, and the address comes from X-Forwarded-For only
# when the request arrives from a proxy you name. The defaults fit a TLS proxy on the same machine, or
# no proxy: the web container trusts the private ranges, and core-api trusts only the web container (the
# private `frontend` network they alone share). A proxy on ANOTHER machine, even on your LAN, must be
# added to PENFII_TRUSTED_PROXIES (keep the frontend subnet in it), or every visitor appears to come from
# the proxy and shares one throttle (core-api logs a warning naming it). A proxy with a public address
# (a cloud load balancer, a CDN) goes in BOTH variables:
#PENFII_EDGE_PROXIES=private_ranges 203.0.113.0/24      (space-separated, for the web container)
#PENFII_TRUSTED_PROXIES=172.29.240.0/24,192.168.1.20     (comma-separated, for core-api: the frontend subnet plus yours)
# The range of that `frontend` network. Change it only if it collides with a network of yours, or for a
# second stack on the same host (two Compose projects cannot share a range). An existing network keeps
# its old range until `docker compose down` removes it.
#PENFII_FRONTEND_SUBNET=172.29.240.0/24

# --- Web Push (optional) ----------------------------------------------------------------------
# Pushes mentions, direct replies, Task assignments and due reminders to people's browsers while
# Penfii is closed. Off while the key is empty. Make a pair with `admin-cli vapid-keys` (inside the
# core-api container) and keep the private key secret. Needs https:// (localhost is fine for tries).
#PENFII_VAPID_PRIVATE_KEY=
#PENFII_VAPID_SUBJECT=mailto:ops@example.com

# --- E-mail (optional) --------------------------------------------------------------------------
# Without PENFII_SMTP_HOST Penfii sends no e-mail and everything still works: an invitation is a link
# that the inviter copies. With it, an invitation link is also mailed. Links in the mail start with
# PENFII_PUBLIC_URL above, so it must be the address people really open (https://...), not localhost.
# PENFII_SMTP_SECURITY: starttls (default, port 587), tls (port 465) or none (port 25, only for a relay
# on a network you trust; it is refused together with a user name and password).
#PENFII_SMTP_HOST=smtp.example.com
#PENFII_SMTP_PORT=
#PENFII_SMTP_SECURITY=starttls
#PENFII_SMTP_USER=
#PENFII_SMTP_PASSWORD=
#PENFII_SMTP_FROM=Penfii <penfii@example.com>

# --- Incoming webhooks (optional) ---------------------------------------------------------------
# Needed only for Signature-mode webhooks (URL-secret ones work without it). 64 hex characters:
# `openssl rand -hex 32`. Keep it secret; changing it breaks existing Signature webhooks until rotated.
#PENFII_WEBHOOK_KEK=

# --- Two-step verification (optional) -----------------------------------------------------------
# People can turn on TOTP sign-in without this. Without it, the key that encrypts their authenticator
# secrets is made on first use and kept in the database (so in every database backup). Set it
# (64 hex characters: `openssl rand -hex 32`) to keep that key out of the database and its backups; then
# back it up separately, because secrets sealed with it cannot be read without it (see docs/operations.md).
#PENFII_MFA_ENCRYPTION_KEY=

# --- MCP gateway (optional) -----------------------------------------------------------------
# Lets AI clients (Claude Code, Codex, ...) work in Penfii as a signed-in person, after that person
# approves the client in the browser. Off by default. The MCP address is PENFII_PUBLIC_URL + /mcp, and
# PENFII_PUBLIC_URL must be https:// (http:// only for localhost or 127.0.0.1), or core-api will not start.
#PENFII_MCP_ENABLED=1
# What a workspace allows until an owner or admin changes it: standard (reads and ticket writes),
# read_only or closed.
#PENFII_MCP_DEFAULT_POLICY=standard
# Dynamic Client Registration, for clients that register themselves instead of publishing a
# client metadata document.
#PENFII_MCP_DCR_ENABLED=1

# --- Optional -------------------------------------------------------------------------------
# Start of every OpenSearch index name. Change it only if the OpenSearch is shared.
#PENFII_OPENSEARCH_INDEX_PREFIX=penfii
# Connections core-api keeps to PostgreSQL (all request handling and background work share them).
# PostgreSQL's own default limit is 100 for everything that connects.
#PENFII_DB_MAX_CONNECTIONS=10
